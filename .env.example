# OpenAI
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4o
OPENAI_TEMPERATURE=0.45

# Collection
MAX_COMPANIES=3
# 테스트할 때만 30처럼 낮게 설정하세요. 비워두면 S&P 500 전체를 훑습니다.
SCAN_LIMIT=
# 조건에 맞는 기업이 없을 때 GitHub Actions를 실패 처리하지 않고 종료합니다.
SKIP_IF_NO_ISSUES=true

# Scheduler, Korea time 기준 매일 오전 7시 30분
RUN_TIME_KST=07:30
# 한 번만 즉시 실행하려면 true로 바꾸세요.
RUN_NOW=false

# Upload: blogger 또는 local 중 선택
BLOG_PLATFORM=blogger
PUBLISH_STATUS=draft

# Google Blogger API
BLOGGER_BLOG_ID=1234567890123456789
AUTO_GENERATE_LABELS=true
MAX_BLOGGER_LABELS=10
# AUTO_GENERATE_LABELS=false일 때만 사용합니다.
BLOGGER_LABELS=S&P 500,US Stocks,Wall Street,Earnings
GOOGLE_CLIENT_SECRET_FILE=client_secret.json
GOOGLE_TOKEN_FILE=token.json

# GitHub Secrets에 넣을 이름
# OPENAI_API_KEY
# BLOGGER_BLOG_ID
# GOOGLE_CLIENT_SECRET_JSON
# GOOGLE_TOKEN_JSON

# BLOG_PLATFORM=local일 때 사용
LOCAL_OUTPUT_PATH=latest_sp500_issue_post.md
