# OpenAI
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.2
MAX_OPENAI_OUTPUT_TOKENS=1500

# RSS collection
RSS_FEED_URLS=https://example.com/feed.xml
MAX_ARTICLE_CHARS=2500
MAX_SUMMARY_INPUT_CHARS=1200
MIN_CLEAN_ARTICLE_CHARS=400
LIMITED_SOURCE_CHARS=800
MIN_MEANINGFUL_SENTENCES=4
MIN_CONTENT_QUALITY_SCORE=45
MAX_RELATED_LINKS=3

# Posting controls
MAX_POSTS_PER_RUN=1
MANUAL_PROMPT_MODE=true
REQUIRE_POST_SUCCESS=true
DRY_RUN=true
PUBLISH_STATUS=draft

# Scheduler, Korea time 기준 월-금 오전 7시
RUN_TIME_KST=07:00
# 한 번만 즉시 실행하려면 true로 바꾸세요.
RUN_NOW=false

# Google Blogger API
BLOGGER_BLOG_ID=1234567890123456789
GOOGLE_CLIENT_SECRET_FILE=client_secret.json
GOOGLE_TOKEN_FILE=token.json

# GitHub Secrets에 넣을 이름
# OPENAI_API_KEY
# BLOGGER_BLOG_ID
# GOOGLE_CLIENT_SECRET_JSON
# GOOGLE_TOKEN_JSON
